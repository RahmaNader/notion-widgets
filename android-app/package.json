{
  "name": "multi-timer-android",
  "version": "1.0.0",
  "private": true,
  "description": "Android app wrapper for the Multi Timer widget (Capacitor)",
  "scripts": {
    "build:web": "node build-web.mjs",
    "sync": "npm run build:web && npx cap sync android",
    "assets": "npx @capacitor/assets generate --android --assetPath assets"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@fortawesome/fontawesome-free": "6.4.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "esbuild": "0.28.2",
    "tailwindcss": "3.4.17",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
